# Google Drive OAuth (from Google Cloud Console)
# Uncomment and set to enable Google Drive cloud save
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OneDrive OAuth (from Azure AD App Registration)
# Uncomment and set to enable OneDrive cloud save
# NEXT_PUBLIC_MICROSOFT_CLIENT_ID=your-microsoft-client-id
